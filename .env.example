# Banco de dados: SQLite embutido via node:sqlite (Node 22+), sem dependencias
# externas. O arquivo fica em ./dev.db por padrao.
DATABASE_PATH=./dev.db

# Nome e contexto do seu negocio (usado nos prompts de IA)
MY_BUSINESS_NAME="Conecta Expo Center"
MY_BUSINESS_CONTEXT="Espaco para eventos corporativos, capacidade de 50 a 2000 pessoas."

# --- Coleta de dados (opcional - sem essas chaves o app usa dados de exemplo) ---
# Apify: usado para coletar posts do Instagram (https://apify.com)
APIFY_TOKEN=
# YouTube Data API v3: gratuito, gerar em https://console.cloud.google.com
YOUTUBE_API_KEY=

# --- Geracao de insights com IA (opcional) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
